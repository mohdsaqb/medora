# Copy to .env and fill in real values. Never commit .env.
#
# Docker Compose reads this file automatically. For the backend, export these
# as environment variables or set them in your hosting provider's dashboard.

# Database. The defaults in application.properties point at the local
# Postgres container defined in compose.yml.
DB_URL=jdbc:postgresql://localhost:5432/medora
DB_USERNAME=medora
DB_PASSWORD=change-me

# Browser origin allowed to call the API. Comma separated for multiple.
# In production this is the deployed frontend URL.
ALLOWED_ORIGIN=http://localhost:3000

# Passwords for the accounts seeded on first boot, one per role.
# Seeding runs only when the users table is empty. Leave blank to skip.
ADMIN_PASSWORD=change-me
DOCTOR_PASSWORD=change-me
RECEPTIONIST_PASSWORD=change-me

# Optional overrides.
# PORT=8185
# DDL_AUTO=update
# SHOW_SQL=false
# DOCKER_COMPOSE_ENABLED=true
