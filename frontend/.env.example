# Copy to .env and adjust. Never commit .env.
#
# Create React App only exposes variables prefixed with REACT_APP_, and they
# are read at build time, not at runtime.

# Backend API base URL, including the /api suffix.
REACT_APP_API_URL=http://localhost:8185/api

# Dev server port. Defaults to 3000 when unset.
PORT=3000
